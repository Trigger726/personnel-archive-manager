<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{DynamicResource Paper}">
  <Grid.RowDefinitions>
    <RowDefinition Height="70"/>
    <RowDefinition Height="*"/>
    <RowDefinition Height="66"/>
  </Grid.RowDefinitions>

  <Border Background="{DynamicResource Wash}" BorderBrush="{DynamicResource Rule}" BorderThickness="0,0,0,1" Padding="22,0">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="218"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <DockPanel x:Name="Brand" VerticalAlignment="Center" LastChildFill="True" Background="Transparent" HorizontalAlignment="Left">
        <Border DockPanel.Dock="Left" Background="{DynamicResource Tint}" Width="34" Height="34" CornerRadius="9" Margin="0,0,11,0">
          <Path Data="M 1,5 L 7,5 L 10,8 L 21,8 L 21,20 L 1,20 Z M 1,10 L 21,10 M 7,14 L 15,14"
                Stroke="{DynamicResource Accent}" StrokeThickness="1.45" StrokeLineJoin="Round"
                Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <Grid VerticalAlignment="Center" TextElement.FontSize="17" TextElement.FontWeight="Medium">
          <TextBlock x:Name="BrandTitle" Text="人事档案管理"/>
          <TextBlock x:Name="TitleCyan" Text="{Binding Text, ElementName=BrandTitle}" Foreground="#047F9B"
                     Visibility="Hidden" IsHitTestVisible="False"/>
          <TextBlock x:Name="TitleRose" Text="{Binding Text, ElementName=BrandTitle}" Foreground="#BE466D"
                     Visibility="Hidden" IsHitTestVisible="False"/>
        </Grid>
      </DockPanel>
      <Grid Grid.Column="1" VerticalAlignment="Center" MaxWidth="670" HorizontalAlignment="Stretch" Margin="0,0,20,0">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Grid Margin="0,0,8,0">
            <TextBox x:Name="SearchBox" MinHeight="36" Padding="36,5,10,5" Background="White"
                     ToolTip="匹配文件名和路径，多个词均须匹配（Ctrl+F）" AutomationProperties.Name="搜索文件名和路径"/>
            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="12,0,0,0"
                       HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource Muted}"/>
            <TextBlock Text="搜索文件名和路径" Margin="37,0,8,0" VerticalAlignment="Center"
                       IsHitTestVisible="False" Foreground="{DynamicResource Muted}">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
          <Button Grid.Column="1" x:Name="SearchButton" Style="{DynamicResource SearchButtonStyle}" Content="搜索" MinWidth="62" Height="36"/>
        </Grid>
      </Grid>
      <StackPanel x:Name="WindowActions" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent">
        <Button x:Name="CollectButton" Style="{DynamicResource SearchButtonStyle}" Content="按清单收集"
                ToolTip="按员工核对多种资料，一次加入待复制" Margin="0,0,9,0"/>
        <Button x:Name="RefreshButton" Style="{DynamicResource TextButton}" Margin="0,0,3,0" ToolTip="刷新档案（F5）" AutomationProperties.Name="刷新">
          <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="刷新"/></StackPanel>
        </Button>
        <Button x:Name="SettingsButton" Style="{DynamicResource TextButton}" AutomationProperties.Name="设置">
          <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="设置"/></StackPanel>
        </Button>
      </StackPanel>
    </Grid>
  </Border>

  <Grid x:Name="ArchiveBody" Grid.Row="1">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="252" MinWidth="188" MaxWidth="340"/>
      <ColumnDefinition Width="6"/>
      <ColumnDefinition Width="*" MinWidth="590"/>
    </Grid.ColumnDefinitions>
    <Border Background="{DynamicResource Rail}" Padding="13,23,13,16">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="档案目录" Foreground="{DynamicResource Muted}" FontWeight="Medium" FontSize="12" Margin="8,0,8,10"/>
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Rule}" BorderThickness="0,1,0,0" Padding="4,12,4,2" Margin="5,8,5,0">
          <StackPanel>
            <TextBlock Text="档案根目录" Foreground="{DynamicResource Muted}" FontSize="11"/>
            <TextBlock x:Name="RootLabel" Text="尚未选择目录" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
          </StackPanel>
        </Border>
      <TreeView x:Name="DirectoryTree" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Ink}" Padding="0"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
        <TreeView.Resources>
          <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                  <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition x:Name="BranchColumn" Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border x:Name="BranchStem" Grid.RowSpan="2" Width="1" HorizontalAlignment="Left" Margin="10,0,0,0"
                            Background="{DynamicResource TreeGuide}" IsHitTestVisible="False"/>
                    <Border x:Name="BranchEnd" Width="1" Height="19" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10,0,0,0"
                            Background="{DynamicResource TreeGuide}" Visibility="Collapsed" IsHitTestVisible="False"/>
                    <Border x:Name="BranchArm" Height="1" Margin="10,0,0,0" VerticalAlignment="Center"
                            Background="{DynamicResource TreeGuide}" IsHitTestVisible="False"/>
                    <Border x:Name="Node" Grid.Column="1" CornerRadius="8" Margin="0,1" Background="Transparent" BorderThickness="1">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <ToggleButton x:Name="Expander" Focusable="False" IsTabStop="False"
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                          <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                              <Grid Background="Transparent">
                                <Path x:Name="Chevron" Data="M 0,0 L 4,4 L 0,8" Stroke="{DynamicResource Muted}" StrokeThickness="1.3"
                                      VerticalAlignment="Center" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5"/>
                              </Grid>
                              <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                  <Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter>
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" Margin="0,0,6,0"/>
                      </Grid>
                    </Border>
                    <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1"/>
                  </Grid>
                  <ControlTemplate.Triggers>
                    <Trigger Property="HasItems" Value="False"><Setter TargetName="Expander" Property="Visibility" Value="Hidden"/></Trigger>
                    <Trigger Property="IsExpanded" Value="False"><Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/></Trigger>
                    <DataTrigger Binding="{Binding IsLast}" Value="True">
                      <Setter TargetName="BranchStem" Property="Visibility" Value="Collapsed"/>
                      <Setter TargetName="BranchEnd" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsRoot}" Value="True">
                      <Setter TargetName="BranchColumn" Property="Width" Value="0"/>
                      <Setter TargetName="BranchStem" Property="Visibility" Value="Collapsed"/>
                      <Setter TargetName="BranchEnd" Property="Visibility" Value="Collapsed"/>
                      <Setter TargetName="BranchArm" Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsOnPath}" Value="True">
                      <Setter TargetName="BranchStem" Property="Background" Value="{DynamicResource TreeGuideActive}"/>
                      <Setter TargetName="BranchEnd" Property="Background" Value="{DynamicResource TreeGuideActive}"/>
                      <Setter TargetName="BranchArm" Property="Background" Value="{DynamicResource TreeGuideActive}"/>
                    </DataTrigger>
                    <Trigger SourceName="Node" Property="IsMouseOver" Value="True"><Setter TargetName="Node" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Node" Property="Background" Value="#DCE8F8"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Node" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </TreeView.Resources>
      </TreeView>
      </DockPanel>
    </Border>
    <Border Grid.Column="1" Background="{DynamicResource Rail}" BorderBrush="{DynamicResource Rule}" BorderThickness="0,0,1,0" IsHitTestVisible="False"/>
    <GridSplitter x:Name="DirectorySplitter" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                  ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="Transparent"
                  Panel.ZIndex="1" ToolTip="拖动调整目录栏宽度" AutomationProperties.Name="调整目录栏宽度">
      <GridSplitter.Style>
        <Style TargetType="GridSplitter">
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="GridSplitter">
                <Border Background="Transparent"><Border x:Name="Divider" Width="2" Background="Transparent"/></Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Divider" Property="Background" Value="{DynamicResource TreeGuideActive}"/></Trigger>
                  <Trigger Property="IsDragging" Value="True"><Setter TargetName="Divider" Property="Background" Value="{DynamicResource Accent}"/></Trigger>
                  <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Divider" Property="Background" Value="{DynamicResource Accent}"/></Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </GridSplitter.Style>
    </GridSplitter>

    <DockPanel x:Name="WorkArea" Grid.Column="2">
      <Border DockPanel.Dock="Top" Padding="22,14,22,13" BorderBrush="{DynamicResource Rule}" BorderThickness="0,0,0,1">
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
            <TextBlock Text="范围" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="ScopeBox" Width="151" Height="33" SelectedIndex="0" VerticalContentAlignment="Center" AutomationProperties.Name="搜索范围">
              <ComboBoxItem Content="全部档案"/>
              <ComboBoxItem Content="当前目录及子目录"/>
            </ComboBox>
          </StackPanel>
          <WrapPanel x:Name="FilterActions" Orientation="Horizontal" Background="Transparent">
            <Button x:Name="DepartmentButton" Style="{DynamicResource FilterButton}" Content="部门"/>
            <Button x:Name="EmployeeButton" Style="{DynamicResource FilterButton}" Content="员工"/>
            <Button x:Name="FormatButton" Style="{DynamicResource FilterButton}" Content="格式"/>
            <Button x:Name="KeywordButton" Style="{DynamicResource FilterButton}" Content="资料关键词"/>
            <Button x:Name="ResetButton" Style="{DynamicResource TextButton}" Content="清空条件" Padding="8,4"
                    ToolTip="清空搜索词和所有筛选条件；可恢复上次条件（搜索框内 Esc）"/>
          </WrapPanel>
        </DockPanel>
      </Border>
      <Border x:Name="SearchSummary" DockPanel.Dock="Top" Margin="22,10,22,0" Padding="10,5" CornerRadius="8" Background="{DynamicResource Wash}" Visibility="Collapsed">
        <DockPanel>
          <Button x:Name="RestoreButton" DockPanel.Dock="Right" Content="恢复上次条件" Style="{DynamicResource TextButton}" Padding="8,2" MinHeight="28"/>
          <TextBlock x:Name="AppliedFilters" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="12"/>
        </DockPanel>
      </Border>
      <DockPanel Margin="22,0,22,0">
        <Grid DockPanel.Dock="Top" Margin="0,20,0,16">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
            <TextBlock x:Name="ViewTitle" Text="档案文件" FontSize="22" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="LocationLabel" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,4,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="UpButton" Style="{DynamicResource TextButton}" Content="上一级" Margin="0,0,6,0" ToolTip="返回上一级目录"/>
            <Button x:Name="SelectResultsButton" Content="全选当前结果（0）" ToolTip="勾选当前结果中的全部文件（列表内 Ctrl+A）；空格切换当前文件勾选"/>
          </StackPanel>
        </Grid>
      <Grid Margin="0,0,0,12">
        <DataGrid x:Name="FilesGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" EnableRowVirtualization="True" EnableColumnVirtualization="True"
                  VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"
                  RowHeight="48" ColumnHeaderHeight="36" CanUserResizeRows="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="None" AlternatingRowBackground="#FAFAFC" BorderThickness="0"
                  ColumnHeaderStyle="{DynamicResource TableHeader}" RowStyle="{DynamicResource ArchiveFileRow}"
                  CellStyle="{DynamicResource ArchiveTableCell}" Background="White">
          <DataGrid.Resources>
            <Style x:Key="FileCellText" TargetType="TextBlock">
              <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
              <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            </Style>
          </DataGrid.Resources>
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="" Width="40" MinWidth="40" CanUserSort="False" CanUserResize="False">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <CheckBox IsChecked="{Binding Checked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            AutomationProperties.Name="{Binding Name}" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <CheckBox.Style>
                      <Style TargetType="CheckBox" BasedOn="{StaticResource ArchiveCheckBox}">
                        <Style.Triggers><DataTrigger Binding="{Binding IsFolder}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                      </Style>
                    </CheckBox.Style>
                  </CheckBox>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="名称与来源" Width="*" MinWidth="225" SortMemberPath="Name">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <DockPanel ToolTip="{Binding DragHint}" Background="Transparent" LastChildFill="True">
                    <Border DockPanel.Dock="Left" Width="30" Height="32" Margin="0,0,10,0" CornerRadius="6" Background="{Binding IconBackground}">
                      <Path Data="{Binding Icon}" Stroke="{Binding IconColor}" StrokeThickness="1.25" StrokeLineJoin="Round"
                            Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Location}" Foreground="{DynamicResource Muted}" FontSize="11.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                  </DockPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="员工" Width="127" MinWidth="104" Binding="{Binding Employee}" ElementStyle="{StaticResource FileCellText}"/>
            <DataGridTextColumn Header="部门" Width="74" MinWidth="65" Binding="{Binding Department}" ElementStyle="{StaticResource FileCellText}"/>
            <DataGridTextColumn Header="格式" Width="61" MinWidth="61" Binding="{Binding FormatLabel}" ElementStyle="{StaticResource FileCellText}"/>
            <DataGridTextColumn Header="修改时间" Width="140" MinWidth="140" Binding="{Binding Modified, StringFormat=yyyy-MM-dd HH:mm}" ElementStyle="{StaticResource FileCellText}"/>
          </DataGrid.Columns>
        </DataGrid>
        <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380" Margin="18,12,18,0">
          <Border Width="52" Height="52" CornerRadius="12" HorizontalAlignment="Center" Background="{DynamicResource Tint}">
            <Path x:Name="EmptyIcon" Stroke="{DynamicResource Accent}" StrokeThickness="1.45" StrokeLineJoin="Round"
                  Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock x:Name="EmptyTitle" FontSize="17" FontWeight="SemiBold" TextAlignment="Center" Margin="0,11,0,0"/>
          <TextBlock x:Name="EmptyMessage" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,12"/>
          <Button x:Name="ChooseRootButton" Style="{DynamicResource PrimaryButton}" Content="选择档案根目录" HorizontalAlignment="Center"/>
        </StackPanel>
      </Grid>
      </DockPanel>
    </DockPanel>
  </Grid>

  <Border Grid.Row="2" Background="{DynamicResource Wash}" BorderBrush="{DynamicResource Rule}" BorderThickness="0,1,0,0" Padding="16,6">
    <Border x:Name="CopyDropZone" AllowDrop="True" CornerRadius="9" AutomationProperties.Name="待复制拖放区">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Background" Value="Transparent"/>
          <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Background" Value="{DynamicResource Tint}"/></DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <Grid>
        <Rectangle x:Name="DropOutline" Stroke="{DynamicResource Accent}" StrokeThickness="1" StrokeDashArray="4 3"
                   RadiusX="8" RadiusY="8" Visibility="Collapsed" IsHitTestVisible="False"/>
        <DockPanel LastChildFill="True" Margin="6,0">
      <StackPanel x:Name="SelectionActions" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0" Background="Transparent">
        <Button x:Name="ClearSelectedButton" Style="{DynamicResource TextButton}" Content="清空已选" Margin="0,0,6,0"/>
        <Button x:Name="SelectedButton" Content="查看已选" Margin="0,0,9,0"/>
        <Button x:Name="CopyButton" Style="{DynamicResource PrimaryButton}" MinWidth="111" Height="37" AutomationProperties.Name="复制到">
          <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Text="复制到…"/></StackPanel>
        </Button>
      </StackPanel>
      <DockPanel VerticalAlignment="Center" LastChildFill="True">
        <Border DockPanel.Dock="Left" Background="{DynamicResource Tint}" CornerRadius="8" Padding="12,7" Margin="0,0,12,0" VerticalAlignment="Center">
          <TextBlock x:Name="SelectionLabel" Text="待复制 0 份" Foreground="{DynamicResource Accent}" FontWeight="Medium" AutomationProperties.LiveSetting="Polite"/>
        </Border>
        <Button x:Name="ProblemsButton" DockPanel.Dock="Right" Style="{DynamicResource TextButton}" Content="查看读取问题"
                Visibility="Collapsed" MinHeight="22" Padding="5,0" Margin="6,0,0,0"/>
        <ProgressBar x:Name="Progress" DockPanel.Dock="Right" Width="78" Height="5" Margin="6,0,0,0" Visibility="Collapsed" Foreground="{DynamicResource Accent}"/>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="DropHint" Text="拖入文件或员工节点" Foreground="{DynamicResource Ink}" FontSize="12" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="StatusLabel" Foreground="{DynamicResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
        </StackPanel>
      </DockPanel>
        </DockPanel>
      </Grid>
    </Border>
  </Border>
</Grid>
